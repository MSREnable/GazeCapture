{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-build",
            "type": "docker-build",
            "platform": "python",
            "dockerBuild": {
				"tag": "gazecapture:latest",
				"dockerfile": "${workspaceFolder}/Dockerfile",
				"context": "${workspaceFolder}",
				"pull": true
			}
        },
        {
            "type": "docker-run",
            "label": "Prepare Eye Catcher",
            "dependsOn": [
				"docker-build"
			],
            "python": {
                "args": ["--task", "'prepareEyeCatcherTask'", "--input", "/data/200407", "--output", "/data/out"],
                "file": "taskCreator.py"
            },
            "dockerRun": {
                "volumes": [
                    {
                        "localPath": "/var/run/docker.sock",
                        "containerPath": "/var/run/docker.sock"
                    },
                    {
                        "localPath": "/data",
                        "containerPath": "/data"
                    },
                    {
                        "localPath": "${workspaceFolder}",
                        "containerPath": "/app"
                    }
                ]
            }
        },
        {
            "type": "docker-run",
            "label": "train (reset)",
            "dependsOn": ["docker-build"],
            "python": {
                "args": ["--data_path", "/data/out-prepped", "--reset"],
                "file": "main.py"
            }
        }
    ]
}